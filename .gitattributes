# Shell scripts must keep LF endings or bash fails on Windows checkouts (autocrlf).
*.sh text eol=lf
# Migrations are checksummed; keep them LF everywhere (migrate.ts also normalizes).
*.sql text eol=lf
# OSM snapshots are sha256-pinned in ingest.source_document and the response is embedded
# byte for byte; never convert their line endings.
*.osm.json -text
