# ParaNaga environment. Copy to .env.local for development. Never commit real values.
# Everything here is server-only unless prefixed NEXT_PUBLIC_.

# --- Database (Neon) ---------------------------------------------------------
# Pooled endpoint, role paranaga_app (runtime). The app never reads DATABASE_URL:
# Vercel's Neon integration manages that one and sets it to the owner role.
PARANAGA_DATABASE_URL=
# Direct endpoint, owner role. Migrations, RLS check and admin bootstrap only (CI secret).
DATABASE_URL_UNPOOLED=

# --- Auth (Neon Managed Better Auth) -----------------------------------------
NEON_AUTH_BASE_URL=
# At least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Object storage (Neon) ---------------------------------------------------
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_PUBLIC=public-media
STORAGE_BUCKET_QUARANTINE=quarantine
STORAGE_BUCKET_EVIDENCE=evidence-private

# --- Jev via OpenRouter ------------------------------------------------------
OPENROUTER_API_KEY=
# Production must use a dated build, e.g. typesafe/jev-1.13-20260917 (aliases are refused).
JEV_MODEL_ID=typesafe/jev-1.13
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
JEV_TIMEOUT_MS=10000
JEV_POLICY_VERSION=paranaga-community-v1
JEV_DAILY_BUDGET_REQUESTS=5000
AUTO_PUBLISH_ENABLED=false
# Off until a privacy impact assessment is done and OpenRouter zero-retention is confirmed.
JEV_COMPLAINTS_ENABLED=false

# --- Map (public) ------------------------------------------------------------
# Unset: OSM tiles outside production (dev/test only); no basemap in production.
# Production (MapTiler):
# NEXT_PUBLIC_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Optional interactive Street View (Maps Embed API only). Browser-visible key:
# restrict to exact website referrers and Maps Embed API in Google Cloud.
# NEXT_PUBLIC values are embedded at build time; redeploy after changing this.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# --- Optional providers ------------------------------------------------------
GEOCODER_PROVIDER=none
WALK_ROUTER_PROVIDER=none
IMAGE_SAFETY_PROVIDER=none

# --- Ops ---------------------------------------------------------------------
# At least 32 characters; Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Used once by `pnpm admin:bootstrap`.
BOOTSTRAP_ADMIN_EMAIL=

# --- Integration tests (throwaway Neon branch only) --------------------------
TEST_OWNER_DATABASE_URL=
TEST_APP_DATABASE_URL=
